# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Frontend build output and dependencies
frontend/node_modules/
frontend/.angular/
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/coverage/
frontend/.env

# Backend dependencies, caches, and secrets
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/public/build/
backend/public/hot/
backend/public/storage
backend/public/fonts-manifest.dev.json
backend/storage/*.key
backend/storage/pail
backend/.phpunit.cache/
backend/.phpunit.result.cache
backend/auth.json

# Local secrets. Example files stay tracked.
.env
.env.*
!.env.example
frontend/src/environments/*.local.ts

# Compiled output if a tool is run from the wrong directory
/dist
/tmp
/out-tsc
/bazel-out
node_modules/
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
frontend/.vscode/*
!frontend/.vscode/settings.json
!frontend/.vscode/tasks.json
!frontend/.vscode/launch.json
!frontend/.vscode/extensions.json
!frontend/.vscode/mcp.json
.history/*

# Miscellaneous
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
*.log
frontend/src/environments/environment.development.ts
frontend/src/environments/environment.development.ts
