APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://frame-backend.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Host-only cookie in both environments. Do not set a parent domain.
# Local DDEV: null
# Production: null
SESSION_DOMAIN=null
# The DDEV API is HTTPS, and SameSite=None is ignored unless the cookie is Secure.
# Local DDEV: true
# Production: true
SESSION_SECURE_COOKIE=true
# localhost and frame-backend.ddev.site are different sites, so Lax cookies are not sent on login.
# The production hosts share kevinmm.dk and can keep Lax.
# Local DDEV: none
# Production: lax
SESSION_SAME_SITE=none
# Lets Chrome keep the cross-site local cookie for localhost only. Invalid together with Lax.
# Local DDEV: true
# Production: false
SESSION_PARTITIONED_COOKIE=true

# Frontend origins that may use the session. Do not list the API host.
# Local DDEV: localhost,localhost:4200,127.0.0.1,127.0.0.1:4200
# Production: wexo.kevinmm.dk
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# One frontend origin per environment. An empty list matches no browser.
# Local DDEV: http://localhost:4200,http://127.0.0.1:4200
# Production: https://wexo.kevinmm.dk
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p